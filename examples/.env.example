# Paystack secret key (test mode: sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Flutterwave webhook secret hash (Settings > Webhooks), only if providers.flutterwave is set
FLUTTERWAVE_SECRET_HASH=replace_me
# Monnify client secret key, only if providers.monnify is set. It verifies monnify-signature.
MONNIFY_SECRET_KEY=replace_me
# Monnify API key (MK_TEST_... / MK_PROD_...), only with providers.monnify.confirm_with_api
MONNIFY_API_KEY=
# Stripe endpoint signing secret (whsec_...), only if providers.stripe is set. `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe restricted key (rk_test_... / rk_live_...) with Events: read, only with providers.stripe.confirm_with_api
STRIPE_API_KEY=
# Per-application secrets: at least 32 bytes each, all distinct. Generate with: openssl rand -hex 32
APP_A_RELAY_SIGNING_SECRET=
APP_A_RELAY_API_TOKEN=
APP_B_RELAY_SIGNING_SECRET=
APP_B_RELAY_API_TOKEN=
# Optional operator settings (see the commented sections of relay.yaml)
# Admin API token, at least 32 bytes, its own value: openssl rand -hex 32
RELAY_ADMIN_TOKEN=
# Alerts destination, e.g. a Slack incoming-webhook URL
RELAY_ALERTS_URL=
# Signing secret for alerts.format: json, at least 32 bytes
RELAY_ALERTS_SECRET=
