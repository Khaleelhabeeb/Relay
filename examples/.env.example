# Paystack secret key (test mode: sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Flutterwave webhook secret hash (Settings > Webhooks), only if providers.flutterwave is set
FLUTTERWAVE_SECRET_HASH=replace_me
# Per-application secrets: at least 32 bytes each, all distinct. Generate with: openssl rand -hex 32
APP_A_RELAY_SIGNING_SECRET=
APP_A_RELAY_API_TOKEN=
APP_B_RELAY_SIGNING_SECRET=
APP_B_RELAY_API_TOKEN=
